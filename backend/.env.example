# --- Exasol Personal connection ---
# Get these by running `exasol info` after `exasol install local` finishes.
EXASOL_HOST=localhost
EXASOL_PORT=8563
EXASOL_USER=sys
EXASOL_PASSWORD=changeme
EXASOL_SCHEMA=CAMPUSPILOT

# --- Triage Agent LLM ---
# Optional. If unset, the Triage Agent falls back to a deterministic
# keyword-based classifier so the demo NEVER breaks because of a missing key.
ANTHROPIC_API_KEY=

# --- Server ---
PORT=4000

# --- Follow-up Agent ---
# Minutes an OPEN ticket can sit before it's considered "overdue" for a
# reminder. Kept low on purpose so it's easy to demo without waiting.
FOLLOWUP_OVERDUE_MINUTES=2
